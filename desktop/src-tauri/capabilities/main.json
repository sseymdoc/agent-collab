{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "原生桥只对主窗口里随包分发的页面开放；没有 remote 域，没有 shell、fs、http、dialog、notification 插件权限（系统通知只经 notify 命令）。",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-connections-list",
    "allow-connection-pair",
    "allow-connection-open",
    "allow-connection-close",
    "allow-connection-forget",
    "allow-api-request",
    "allow-stream-open",
    "allow-stream-close",
    "allow-blob-save",
    "allow-notify",
    "allow-project-bind",
    "allow-project-bindings",
    "allow-project-unbind",
    "allow-project-scan",
    "allow-project-upload",
    "allow-project-cancel",
    "allow-result-download",
    "allow-result-plan",
    "allow-result-apply",
    "allow-result-unfinished",
    "allow-result-recover",
    "allow-local-discover",
    "allow-local-setup",
    "allow-local-service",
    "allow-local-pair"
  ]
}
