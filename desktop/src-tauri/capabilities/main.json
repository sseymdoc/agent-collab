{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "原生桥只对主窗口里随包分发的页面开放；没有 remote 域，没有 shell、fs、http 插件权限。",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-connections-list",
    "allow-connection-pair",
    "allow-connection-open",
    "allow-connection-close",
    "allow-connection-forget",
    "allow-api-request",
    "allow-stream-open",
    "allow-stream-close",
    "allow-blob-save"
  ]
}
